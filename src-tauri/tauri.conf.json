{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "husk",
  "version": "0.1.5",
  "identifier": "com.akikp.husk",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "husk",
        "width": 1200,
        "height": 800,
        "minWidth": 420,
        "minHeight": 280,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": null,
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGRDc1RkVBMjAzOEE2QUUKUldTdXBqZ2c2bC9YSDB6Z1dRQ1RiMHN1V2RwZ3hyaXg2Wiszc3hYQ2ZDU3VsblJEM0ptc3llOTYK",
      "endpoints": [
        "https://github.com/0xakikp/husk/releases/latest/download/latest.json"
      ]
    }
  }
}
